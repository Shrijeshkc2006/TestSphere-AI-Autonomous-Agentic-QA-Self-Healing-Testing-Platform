# =============================================================================
# TestSphere — Environment Configuration Example
# Copy this to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://testsphere:testsphere_dev_password@localhost:5432/testsphere
DATABASE_URL_SYNC=postgresql://testsphere:testsphere_dev_password@localhost:5432/testsphere

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI (Google Gemini) ---
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- File upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# --- Test execution ---
PLAYWRIGHT_BROWSER=chromium
TEST_TIMEOUT_SECONDS=120
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=1.0

# --- Self-healing ---
SELF_HEAL_ENABLED=true
SELF_HEAL_CONFIDENCE_THRESHOLD=0.75

# --- Artifact storage ---
ARTIFACT_DIR=./artifacts
ARTIFACT_RETENTION_DAYS=30

# --- Demo mode (only when real services are unavailable) ---
DEMO_MODE=false
