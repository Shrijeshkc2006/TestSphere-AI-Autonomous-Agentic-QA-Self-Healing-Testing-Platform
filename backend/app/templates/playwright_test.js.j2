// TestSphere — Playwright test template
// Generated by TestSphere AI test generator
// DO NOT EDIT manually — regenerate via the TestSphere UI

const { test, expect } = require('@playwright/test');

test.describe({{ plan_name | tojson }}, () => {
  test.setTimeout({{ total_timeout_ms }});

  {% for step in steps %}
  // Step {{ step.order }}: {{ step.title }}
  {% endfor %}

  test({{ plan_name | tojson }}, async ({ page, context }) => {
    // Capture console errors
    const consoleErrors = [];
    page.on('console', msg => {
      if (msg.type() === 'error') consoleErrors.push(msg.text());
    });

    // Capture failed network requests
    const failedRequests = [];
    page.on('requestfailed', request => {
      failedRequests.push({ url: request.url(), failure: request.failure()?.errorText });
    });

    {% for step in steps %}
    // -- Step {{ step.order }}: {{ step.title }} ------------------------------
    {% if step.description %}
    // {{ step.description }}
    {% endif %}
    {%- if step.action_type == 'navigate' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.goto({{ (step.value or '') | tojson }}, { waitUntil: 'domcontentloaded', timeout: {{ step.timeout_ms or 30000 }} });
    });

    {%- elif step.action_type == 'click' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      const el = page.locator({{ (step.selector or '') | tojson }});
      await expect(el).toBeVisible({ timeout: {{ step.timeout_ms or 10000 }} });
      await el.click({ timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'fill' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      const el = page.locator({{ (step.selector or '') | tojson }});
      await expect(el).toBeVisible({ timeout: {{ step.timeout_ms or 10000 }} });
      await el.fill({{ (step.value or '') | tojson }}, { timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'assert_text' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      {% if step.selector %}
      await expect(page.locator({{ (step.selector or '') | tojson }})).toContainText({{ (step.assertion or '') | tojson }}, { timeout: {{ step.timeout_ms or 10000 }} });
      {% else %}
      await expect(page.getByText({{ (step.assertion or '') | tojson }})).toBeVisible({ timeout: {{ step.timeout_ms or 10000 }} });
      {% endif %}
    });

    {%- elif step.action_type == 'assert_visible' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await expect(page.locator({{ (step.selector or '') | tojson }})).toBeVisible({ timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'assert_url' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await expect(page).toHaveURL(new RegExp({{ (step.assertion or '') | tojson }}), { timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'wait' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      {% if step.selector %}
      await page.waitForSelector({{ (step.selector or '') | tojson }}, { timeout: {{ step.timeout_ms or 10000 }} });
      {% else %}
      await page.waitForTimeout({{ step.value or 1000 }});
      {% endif %}
    });

    {%- elif step.action_type == 'screenshot' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.screenshot({ path: 'screenshots/step-{{ step.order }}.png', fullPage: false });
    });

    {%- elif step.action_type == 'hover' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.locator({{ (step.selector or '') | tojson }}).hover({ timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'select' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.locator({{ (step.selector or '') | tojson }}).selectOption({{ (step.value or '') | tojson }}, { timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'check' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.locator({{ (step.selector or '') | tojson }}).check({ timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- elif step.action_type == 'uncheck' %}
    await test.step({{ ("Step " ~ step.order ~ ": " ~ step.title) | tojson }}, async () => {
      await page.locator({{ (step.selector or '') | tojson }}).uncheck({ timeout: {{ step.timeout_ms or 10000 }} });
    });

    {%- else %}
    // Unknown action_type: {{ step.action_type }} — skipped
    {%- endif %}

    {% endfor %}

    // Attach diagnostics
    if (consoleErrors.length > 0) {
      console.log('Console errors:', JSON.stringify(consoleErrors));
    }
    if (failedRequests.length > 0) {
      console.log('Failed requests:', JSON.stringify(failedRequests));
    }
  });
});
